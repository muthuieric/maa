# NenoGuard environment template — copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; never commit real credentials.
POSTGRES_USER=nenoguard_admin
POSTGRES_PASSWORD=change-me-generate-with-`python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
POSTGRES_DB=narratives_meta
MONGO_INITDB_DATABASE=narratives_db
